# Copy values into your PowerShell session, e.g.  $env:MANASETU_PROFILE = "correctional"
MANASETU_PROFILE=atrocity_victims     # or: correctional
MANASETU_SEED_PASSWORD=               # optional: one password for all demo staff accounts
MANASETU_COOKIE_SECURE=0              # set 1 when served over HTTPS
